  "privacyPolicyIntroduction": "Introduction",
  "@privacyPolicyIntroduction": {"description": "Privacy policy introduction section"},
  "privacyPolicyIntroductionText": "Tag & Seal respects your privacy and is committed to protecting your personal information. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you use our mobile application.",
  "@privacyPolicyIntroductionText": {"description": "Privacy policy introduction text"},
  "privacyPolicyInformationWeCollect": "Information We Collect",
  "@privacyPolicyInformationWeCollect": {"description": "Privacy policy information we collect section"},
  "privacyPolicyInformationWeCollectText": "We collect information that you provide directly to us, including farm details, livestock data, health records, and user account information. We also collect device information, location data (with your permission), and usage statistics to improve our services.",
  "@privacyPolicyInformationWeCollectText": {"description": "Privacy policy information we collect text"},
  "privacyPolicyHowWeUseInformation": "How We Use Your Information",
  "@privacyPolicyHowWeUseInformation": {"description": "Privacy policy how we use information section"},
  "privacyPolicyHowWeUseInformationText": "We use the collected information to provide, maintain, and improve our services, process your requests, send you notifications, and ensure compliance with livestock regulations. We do not sell your personal information to third parties.",
  "@privacyPolicyHowWeUseInformationText": {"description": "Privacy policy how we use information text"},
  "privacyPolicyDataSecurity": "Data Security",
  "@privacyPolicyDataSecurity": {"description": "Privacy policy data security section"},
  "privacyPolicyDataSecurityText": "We implement appropriate technical and organizational measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction. Your data is encrypted both in transit and at rest, and we regularly review our security practices.",
  "@privacyPolicyDataSecurityText": {"description": "Privacy policy data security text"},
  "privacyPolicyYourRights": "Your Rights",
  "@privacyPolicyYourRights": {"description": "Privacy policy your rights section"},
  "privacyPolicyYourRightsText": "You have the right to access, update, or delete your personal information at any time. You can also request a copy of your data or withdraw consent for data processing. To exercise these rights, please contact us using the information provided below.",
  "@privacyPolicyYourRightsText": {"description": "Privacy policy your rights text"},
  "privacyPolicyContactUs": "Contact Us",
  "@privacyPolicyContactUs": {"description": "Privacy policy contact us section"},
  "privacyPolicyContactUsText": "If you have any questions about this Privacy Policy, please contact us at info@climbup.co.tz or through the app's support section.",
  "@privacyPolicyContactUsText": {"description": "Privacy policy contact us text"},
  
